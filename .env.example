VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key

# Optional. Must exactly match a URL in the Supabase Auth redirect allowlist.
# Defaults to the browser origin. For Codespaces, use its forwarded port 5173 URL.
# VITE_AUTH_REDIRECT_URL=

# Local FinNLP bridge only; keep both values server-side.
FINNHUB_API_KEY=
FINNLP_BRIDGE_API_KEY=
FINNLP_BRIDGE_URL=http://127.0.0.1:8000
